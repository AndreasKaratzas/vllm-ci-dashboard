{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "words": [
    "CREAT",
    "ffdx",
    "FIPS",
    "fstat",
    "inodes",
    "mkfifo",
    "mktree",
    "oids",
    "RDONLY",
    "RDWR",
    "reprojection",
    "strftime",
    "strptime",
    "treeish",
    "udcff",
    "undeployable",
    "unretained",
    "unsplittable",
    "WRONLY"
  ],
  "ignorePaths": [
    ".venv/**",
    "node_modules/**",
    "data/**",
    "_site/**",
    "docs/assets/vendor/**",
    "dashboards/**",
    "**/*.lock",
    "**/*.min.js",
    "**/*.min.css",
    ".git/**"
  ],
  "allowCompoundWords": true
}
