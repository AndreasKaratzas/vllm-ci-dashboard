_site/
__pycache__/
.DS_Store
.hypothesis/

# Python / packaging
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Environments
.venv/
venv/
.env
node_modules/

# direnv / Nix
.direnv/
.envrc.local
result
result-*

# Claude Code runtime (agent prompts, skills, scheduled-task state)
.claude/

# Local dev symlink — data/ is copied into _site/data/ at deploy time
docs/data
# Codex
.codex

# Buildkite build cache: scrubbed of PII on write, but the raw response
# from Buildkite contains contributor emails, so we never track these.
# Regenerated by collect_analytics / buildkite_client on the next run.
data/vllm/ci/.cache/

# Plaintext DNS scanner state exists only in an Actions runner. The public
# dns-health-data branch retains authenticated ciphertext; Pages publishes
# only dns_failures.json.
data/vllm/ci/dns_health/

# The private Operations monolith and its public lazy sections are generated
# at collection/site-assembly time. Only the small manifest is tracked.
data/vllm/ci/operations_v2.json
data/vllm/ci/operations_v2.json.gz
data/vllm/ci/operations_v2/

# Durable, privacy-minimized queue lifecycle observations are reconciled on
# the orphan queue-lifecycle-data branch. Main and Pages retain only the
# bounded aggregate so the seven-day ledger does not enter repository history.
data/vllm/ci/queue_lifecycle_jobs/
data/vllm/ci/.queue_lifecycle_jobs.stage.*/
data/vllm/ci/.queue_lifecycle_jobs.backup.*/
# Recoverable agent-health transaction directories must never be swept into a
# broad generated-data commit if a runner is interrupted during rollback.
data/vllm/ci/.agent_health.stage.*/
data/vllm/ci/.agent_health.backup.*/
