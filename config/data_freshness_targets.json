    "ci_ownership": {"label": "CI ownership", "area": "health", "kind": "collector"},
    "perf_eval": {"label": "Perf eval", "area": "perf", "kind": "collector", "path": "perf_eval/perf_eval.json", "stale_minutes": 600},
    "amd_test_signal": {"label": "Latest AMD nightly signal", "area": "health", "kind": "upstream_activity", "collector_limit_minutes": 2160}
