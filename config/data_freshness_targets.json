  "sources": {
    "analytics": {"label": "CI analytics", "area": "analytics", "kind": "collector"},
    "main_ci": {"label": "Main CI builds", "area": "analytics", "kind": "collector"},
    "ci_health": {"label": "CI health", "area": "health", "kind": "collector"},
    "config_parity": {"label": "Configuration parity", "area": "health", "kind": "collector"},
    "test_group_parity": {"label": "Upstream test-group parity", "area": "health", "kind": "collector"},
    "amd_test_matrix": {"label": "AMD hardware matrix", "area": "health", "kind": "collector"},
    "capacity_monitor": {"label": "Queue capacity", "area": "omni", "kind": "collector"},
    "workload_mapping": {"label": "Queue workload mapping", "area": "omni", "kind": "collector"},
    "queue_timeseries": {"label": "Live queue", "area": "omni", "kind": "collector", "collector_limit_minutes": 60},
    "queue_jobs": {"label": "Queue jobs", "area": "omni", "kind": "collector"},
    "omni_heuristic": {"label": "Omni surge heuristic", "area": "omni", "kind": "collector"},
    "omni_issue_state": {"label": "Omni surge issues", "area": "omni", "kind": "collector"},
    "agent_health": {"label": "CI agent health", "area": "analytics", "kind": "collector"},
